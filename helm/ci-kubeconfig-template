apiVersion: v1
kind: Config
clusters:
- cluster:
    certificate-authority-data: <CA_DATA>
    server: <SERVER_URL>
  name: fumen-cluster
contexts:
- context:
    cluster: fumen-cluster
    namespace: fumen
    user: ci-helm
  name: fumen-context
current-context: fumen-context
users:
- name: ci-helm
  user:
    token: <CI_HELM_TOKEN>
