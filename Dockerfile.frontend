FROM node:22-bookworm-slim AS build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm install

COPY frontend/ ./
RUN npm run build

FROM node:22-bookworm-slim

ARG APP_UID=10001
ARG APP_GID=10001

RUN groupadd --system --gid "${APP_GID}" app \
    && useradd --system --uid "${APP_UID}" --gid app --create-home --home-dir /home/app app \
    && mkdir -p /app \
    && chown -R app:app /app /home/app

WORKDIR /app

COPY --from=build --chown=app:app /app/build /app/build
COPY --from=build --chown=app:app /app/package.json /app/package.json
COPY --from=build --chown=app:app /app/package-lock.json /app/package-lock.json
COPY --chmod=755 --chown=app:app docker/frontend-entrypoint.sh /usr/local/bin/frontend-entrypoint.sh

RUN npm ci --omit=dev --ignore-scripts \
    && npm cache clean --force \
    && chown -R app:app /app

ENV API_BASE_URL=""
ENV HOST=0.0.0.0
ENV PORT=8080

EXPOSE 8080

USER ${APP_UID}:${APP_GID}

CMD ["/usr/local/bin/frontend-entrypoint.sh"]
